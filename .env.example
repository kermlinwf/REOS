VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Auth is off by default (solo / local mode). Set to true to require Supabase login.
# VITE_REQUIRE_AUTH=true

# Optional: only needed at build time for GitHub Pages project sites
# Example: VITE_BASE_PATH=/REOS/
# VITE_BASE_PATH=/
